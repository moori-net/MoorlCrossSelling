<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/master/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>General</title>
        <title lang="de-DE">Konfiguration</title>

        <input-field type="bool">
            <name>active</name>
            <label>Active</label>
            <label lang="de-DE">Aktiv</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="int">
            <name>itemLimit</name>
            <label>Item limit per cross-selling list</label>
            <label lang="de-DE">Artikelbegrenzung pro Cross-Selling-Liste</label>
            <defaultValue>12</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>createRelationsStrategy</name>
            <label>Strategy for creating product relations</label>
            <label lang="de-DE">Strategie zum Aufbau von Produktbeziehungen</label>
            <options>
                <option>
                    <id>scheduled</id>
                    <name>Scheduled task: moorl_cross_selling.create_relations</name>
                    <name lang="de-DE">Geplante Aufgabe: moorl_cross_selling.create_relations</name>
                </option>
                <option>
                    <id>disabled</id>
                    <name>Console: bin/console moorl:cross-selling:create-relations [-t] [-f]</name>
                </option>
            </options>
            <defaultValue>scheduled</defaultValue>
        </input-field>

        <input-field type="single-select">
            <name>updateProductsStrategy</name>
            <label>Strategy for updating products</label>
            <label lang="de-DE">Strategie zum Aktualisieren von Produkten</label>
            <options>
                <option>
                    <id>indexer</id>
                    <name>Indexer (while saving or re-indexing)</name>
                    <name lang="de-DE">Indexer (beim Speichern oder erneuten Indizieren)</name>
                </option>
                <option>
                    <id>disabled</id>
                    <name>Console: bin/console moorl:cross-selling:update-products [-t] [-f]</name>
                </option>
            </options>
            <defaultValue>indexer</defaultValue>
        </input-field>
    </card>

    <card>
        <title>Translations</title>
        <title lang="de-DE">Übersetzungen</title>

        <component name="moorl-translated-text-field">
            <name>bought</name>
            <label>Frequently bought together</label>
            <label lang="de-DE">Häufig zusammen gekauft</label>
            <placeholder>Frequently bought together</placeholder>
            <placeholder lang="de-DE">Häufig zusammen gekauft</placeholder>
        </component>

        <component name="moorl-translated-text-field">
            <name>viewed</name>
            <label>Frequently viewed together</label>
            <label lang="de-DE">Häufig zusammen angesehen</label>
            <placeholder>Frequently viewed together</placeholder>
            <placeholder lang="de-DE">Häufig zusammen angesehen</placeholder>
        </component>

        <component name="moorl-translated-text-field">
            <name>history</name>
            <label>Recently viewed</label>
            <label lang="de-DE">Zuletzt angesehen</label>
            <placeholder>Recently viewed</placeholder>
            <placeholder lang="de-DE">Zuletzt angesehen</placeholder>
        </component>
    </card>
</config>
