<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/shopware/platform/master/src/Core/System/SystemConfig/Schema/config.xsd">
    <card>
        <title>General</title>
        <title lang="de-DE">Konfiguration</title>

        <input-field type="bool">
            <name>active</name>
            <label>Active</label>
            <label lang="de-DE">Aktiv</label>
            <defaultValue>true</defaultValue>
        </input-field>

        <input-field type="bool">
            <name>mergeAll</name>
            <label>Merge all cross-selling lists</label>
            <label lang="de-DE">Alle Cross-Selling-Listen zusammenführen</label>
            <defaultValue>false</defaultValue>
        </input-field>

        <input-field type="int">
            <name>itemLimit</name>
            <label>Item limit per cross-selling list</label>
            <label lang="de-DE">Artikelbegrenzung pro Cross-Selling-Liste</label>
            <defaultValue>12</defaultValue>
        </input-field>
    </card>
</config>
