<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="MoorlCrossSelling\Core\Content\CrossSellingSession\CrossSellingSessionDefinition">
            <tag name="shopware.entity.definition" entity="moorl_cs_session"/>
        </service>

        <service id="MoorlCrossSelling\Core\Content\CrossSellingSession\CrossSellingSessionProductDefinition">
            <tag name="shopware.entity.definition" entity="moorl_cs_session_product"/>
        </service>

        <service id="MoorlCrossSelling\Core\Content\CrossSellingRelation\CrossSellingRelationDefinition">
            <tag name="shopware.entity.definition" entity="moorl_cs_relation"/>
        </service>

        <service id="MoorlCrossSelling\Core\Service\CrossSellingService">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="moorl_cs_session.repository"/>
            <argument type="service" id="moorl_cs_session_product.repository"/>
            <argument type="service" id="moorl_cs_relation.repository"/>
            <argument type="service" id="order.repository"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="product_cross_selling.repository"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="MoorlCrossSelling\Core\Content\Product\ProductSubscriber">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="MoorlCrossSelling\Core\Service\CrossSellingService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="MoorlCrossSelling\Core\Content\Customer\CustomerSubscriber">
            <argument type="service" id="MoorlCrossSelling\Core\Service\CrossSellingService"/>
            <tag name="kernel.event_subscriber"/>
        </service>

        <service id="MoorlCrossSelling\Core\Task\CrossSellingCreateRelationsTask">
            <tag name="shopware.scheduled.task"/>
        </service>

        <service id="MoorlCrossSelling\Core\Task\CrossSellingCreateRelationsTaskHandler">
            <argument type="service" id="scheduled_task.repository"/>
            <argument type="service" id="logger"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="MoorlCrossSelling\Core\Service\CrossSellingService"/>
            <tag name="messenger.message_handler"/>
        </service>

        <service id="MoorlCrossSelling\Core\Command\CrossSellingCreateRelationsCommand">
            <argument type="service" id="MoorlCrossSelling\Core\Service\CrossSellingService"/>
            <tag name="console.command"/>
        </service>

        <service id="MoorlCrossSelling\Core\Command\CrossSellingUpdateProductsCommand">
            <argument type="service" id="MoorlCrossSelling\Core\Service\CrossSellingService"/>
            <tag name="console.command"/>
        </service>

        <service id="MoorlCrossSelling\Core\Content\Product\Cms\CrossSellingHistoryCmsElementResolver"
                 parent="Shopware\Core\Content\Product\Cms\ProductSliderCmsElementResolver">
            <argument type="service" id="MoorlCrossSelling\Core\Service\CrossSellingService"/>
            <tag name="shopware.cms.data_resolver"/>
        </service>

        <service id="MoorlCrossSelling\Storefront\Controller\CrossSellingController" public="true">
            <argument type="service" id="MoorlCrossSelling\Core\Service\CrossSellingService"/>
            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="MoorlCrossSelling\Data\Data">
            <tag name="moorl.foundation.data" priority="1001"/>
        </service>
    </services>
</container>
