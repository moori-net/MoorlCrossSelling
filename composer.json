{
    "name": "moorl/cross-selling",
    "description": "Automatic cross-selling",
    "version": "0.7.4",
    "license": "proprietary",
    "authors": [
        {
            "name": "moori"
        }
    ],
    "require": {
        "shopware/core": "~6.7.0",
        "moorl/foundation": "~1.7.55"
    },
    "type": "shopware-platform-plugin",
    "autoload": {
        "psr-4": {
            "MoorlCrossSelling\\": "src/"
        }
    },
    "extra": {
        "shopware-plugin-class": "MoorlCrossSelling\\MoorlCrossSelling",
        "copyright": "(c) by moori",
        "label": {
            "de-DE": "Automatisches Cross-Selling",
            "en-GB": "Automatic cross-selling"
        },
        "description": {
            "de-DE": "Dieses Plugin erfasst Seitenaufrufe auf Produktseiten und Bestellungen. Auf Grundlage der gesammelten Daten werden automatisch Cross-Selling-Listen erstellt.",
            "en-GB": "This simple plugin tracks product page views and placed orders. Cross-selling lists and view histories are automatically generated based on the collected data."
        },
        "manufacturerLink": {
            "de-DE": "https://docs.moori.net/",
            "en-GB": "https://docs.moori.net/"
        },
        "supportLink": {
            "de-DE": "https://docs.moori.net/",
            "en-GB": "https://docs.moori.net/"
        }
    }
}